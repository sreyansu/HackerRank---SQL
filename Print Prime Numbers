WITH RECURSIVE prime AS (
    SELECT 2 AS n
    UNION ALL
    SELECT n + 1
    FROM prime
    WHERE n < 1000
)
SELECT GROUP_CONCAT(p1.n SEPARATOR '&')
FROM prime p1
WHERE NOT EXISTS (
    SELECT 1
    FROM prime p2
    WHERE p2.n > 1
      AND p2.n < p1.n
      AND p2.n <= SQRT(p1.n)
      AND MOD(p1.n, p2.n) = 0
);
